{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learn2earn-ai",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "OPENAI_QUIZ_MODEL": "gpt-5.6-luna",
    "CLOUDFLARE_ACCOUNT_ID": "1d9e8ba693781f363f7cd52941566af8",
    "AI_GATEWAY_ID": "default"
  },
  "pages_build_output_dir": "public",
  "d1_databases": [
    {
      "binding": "AI_QUOTA_DB",
      "database_name": "learn2earn-ai-quota",
      "database_id": "e6acd8da-36f4-4f35-a85d-26c04f1eb4c9",
      "migrations_dir": "migrations"
    }
  ]
}
