<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/l2e_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_account_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="serif"
                android:text="Learn2Earn"
                android:contentDescription="Learn2Earn credits"
                android:textColor="@color/l2e_ink"
                android:textSize="36sp" />

            <Button
                android:id="@+id/btn_reset_role"
                style="@style/L2E.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_secondary"
                android:backgroundTint="@null"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Switch user"
                android:textColor="@color/l2e_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_account_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="serif"
            android:text="Welcome back"
            android:textColor="@color/l2e_ink"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to keep your quizzes, paired devices, and settings together across your parent phones."
            android:textColor="@color/l2e_muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_account_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_tactile_input"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_account_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tactile_input"
            android:padding="0dp"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_account_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_account_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tactile_input"
            android:padding="0dp"
            android:visibility="gone"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_account_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Confirm password"
                android:inputType="textPassword"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_account_continue"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:backgroundTint="@null"
            android:text="Sign in"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_account_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:text="New here? Create an account"
            android:textColor="@color/l2e_forest"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_continue_guest"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:text="Continue as guest"
            android:textColor="@color/l2e_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Guest mode includes 3 AI quiz drafts. Create an account to keep using AI."
            android:textColor="@color/l2e_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
