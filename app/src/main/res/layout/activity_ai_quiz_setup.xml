<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_quiz_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/l2e_canvas"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/btn_ai_back"
            style="@style/L2E.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:text="Back"
            android:textColor="@color/l2e_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="Create quiz with AI"
            android:textColor="@color/l2e_ink"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tell us what your child should practise. You can edit every question before saving."
            android:textColor="@color/l2e_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Subject"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_ai_subject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Grade"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_ai_grade"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Topic (optional)"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_ai_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:gravity="top"
            android:hint="Optional. AI chooses an appropriate topic when blank."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="200"
            android:minLines="3"
            android:padding="16dp"
            android:textColor="@color/l2e_ink"
            android:textColorHint="@color/l2e_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Curriculum note (optional)"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_ai_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:gravity="top"
            android:hint="Example: Cambridge Lower Secondary Mathematics 7, Vietnam international school"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="3"
            android:padding="16dp"
            android:textColor="@color/l2e_ink"
            android:textColorHint="@color/l2e_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Difficulty"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_ai_difficulty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Questions"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_ai_question_count"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:hint="5"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Number of quizzes"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_ai_quiz_count"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tactile_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Do not include child names or private information."
            android:textColor="@color/l2e_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pb_ai_generating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_ai_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/l2e_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_generate_ai_quiz"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:backgroundTint="@null"
            android:text="Generate editable quiz"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
