<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/l2e_canvas"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Your kids' devices"
        android:textColor="@color/l2e_ink"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pair a device, then manage its focus from here."
        android:textColor="@color/l2e_muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_connect_child"
        style="@style/L2E.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_primary"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_child"
        android:drawableTint="@color/white"
        android:text="Connect a child"
        android:textColor="@color/white" />

    <FrameLayout
        android:id="@+id/ll_code_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_bezel_outer"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_citrus"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAIRING CODE"
                    android:textColor="@color/l2e_forest"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_pairing_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:text="--------"
                    android:textColor="@color/l2e_ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btn_cancel_code"
        style="@style/L2E.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_btn_secondary"
        android:backgroundTint="@null"
        android:text="Cancel code"
        android:textColor="@color/l2e_ink"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_kids_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="CONNECTED DEVICES"
        android:textColor="@color/l2e_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_children"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tv_children_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="Loading connected devices..."
            android:textColor="@color/l2e_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_children_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="Could not load connected devices. Check your connection and Firebase access."
            android:textColor="@color/l2e_danger"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No devices yet"
                android:textColor="@color/l2e_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Generate a pairing code to bring a child device into your circle."
                android:textColor="@color/l2e_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
