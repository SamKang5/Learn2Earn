<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_child_item"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_emergency_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/l2e_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_emergency_contact_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/l2e_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_move_contact_up"
            style="@style/L2E.Button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:contentDescription="Move contact up"
            android:text="↑"
            android:textColor="@color/l2e_ink"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_move_contact_down"
            style="@style/L2E.Button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:contentDescription="Move contact down"
            android:text="↓"
            android:textColor="@color/l2e_ink"
            android:textSize="20sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_edit_contact"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:contentDescription="Edit contact"
            android:padding="0dp"
            android:src="@drawable/ic_edit_small"
            android:tint="@color/l2e_ink" />

        <ImageButton
            android:id="@+id/btn_remove_contact"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_danger"
            android:backgroundTint="@null"
            android:contentDescription="Remove contact"
            android:padding="0dp"
            android:src="@drawable/ic_trash_light" />
    </LinearLayout>
</LinearLayout>
