<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quiz_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/l2e_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_top_island"
        android:gravity="center_vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_editor_back"
            style="@style/L2E.Button"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Back"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Quiz editor"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save_quiz"
            style="@style/L2E.Button"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Save"
            android:textColor="@color/l2e_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:id="@+id/fl_quiz_cover"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:background="@drawable/bg_surface_citrus"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_cover_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Choose a cover image"
                    android:textColor="@color/l2e_forest"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_default_quiz_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Default quiz cover"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_quiz_cover"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_quiz_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Quiz thumbnail"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <View
                    android:id="@+id/view_cover_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.6"
                    android:background="@color/black"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_cover_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_edit_cover"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:contentDescription="Change cover image"
                        android:src="@drawable/ic_edit_small"
                        app:tint="@color/l2e_forest" />

                    <ImageButton
                        android:id="@+id/btn_delete_cover"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_btn_danger"
                        android:contentDescription="Remove cover image"
                        android:src="@drawable/ic_delete_small"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Quiz details"
                android:textColor="@color/l2e_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Name"
                android:textColor="@color/l2e_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_quiz_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tactile_input"
                android:hint="e.g. Fractions practice"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/l2e_ink"
                android:textColorHint="@color/l2e_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subject"
                        android:textColor="@color/l2e_muted"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/sp_quiz_subject"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tactile_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:popupBackground="@color/l2e_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grade"
                        android:textColor="@color/l2e_muted"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/sp_quiz_grade"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tactile_input"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:popupBackground="@color/l2e_surface" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Reward rules"
                android:textColor="@color/l2e_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Higher scores must earn more. Top reward is this quiz’s prize pool."
                android:textColor="@color/l2e_muted"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_bezel_outer"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_inner"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Score threshold (%)"
                                android:textColor="@color/l2e_muted"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/et_passing_score"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_tactile_input"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:selectAllOnFocus="true"
                                android:textColor="@color/l2e_ink"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time earned (minutes)"
                                android:textColor="@color/l2e_muted"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/et_reward_minutes"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_tactile_input"
                                android:gravity="center_vertical"
                                android:inputType="number"
                                android:maxLength="3"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:selectAllOnFocus="true"
                                android:textColor="@color/l2e_ink"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/ll_reward_tiers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <Button android:id="@+id/btn_add_reward_tier" style="@style/L2E.Button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_secondary" android:text="Add score threshold" android:textColor="@color/l2e_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Score-improvement cooldown (minutes)"
                        android:textColor="@color/l2e_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_score_improve_cooldown"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tactile_input"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:maxLength="5"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/l2e_ink"
                        android:textSize="16sp" />

                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/l2e_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Questions"
                android:textColor="@color/l2e_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Questions and answers can use text, images, or both."
                android:textColor="@color/l2e_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/ll_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_add_question"
                style="@style/L2E.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Add question"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
