<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/child_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btn_child_quiz_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_child_icon_tile"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_child_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Quiz"
            android:textColor="@color/child_ink"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/quiz_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="@color/child_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_child_icon_tile"
                android:padding="19dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_child_earn" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_quiz_empty_message"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/child_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_quiz_empty_done"
                style="@style/L2E.Button"
                android:layout_width="220dp"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_child_secondary"
                android:backgroundTint="@null"
                android:text="Back to Earn"
                android:textColor="@color/child_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_child_quiz_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/child_ink"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_child_quiz_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/child_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_quiz_attempt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/child_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_quiz_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/child_accent"
                android:textSize="13sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_child_card"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tv_child_quiz_prompt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/child_ink"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/iv_child_quiz_image"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="14dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Quiz image"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_quiz_selection_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/child_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_child_quiz_choices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <Button
                android:id="@+id/btn_quiz_continue"
                style="@style/L2E.Button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_child_primary"
                android:backgroundTint="@null"
                android:text="Next"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_child_balance"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_child_earn"
                    app:tint="@color/child_on_dark_muted" />

                <TextView
                    android:id="@+id/tv_quiz_result_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/child_on_dark"
                    android:textSize="52sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quiz_result_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/child_on_dark"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tv_quiz_result_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textColor="@color/child_on_dark_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_quiz_result_action"
                    style="@style/L2E.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_child_secondary"
                    android:backgroundTint="@null"
                    android:textColor="@color/child_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
