<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_child_item"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_question_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/l2e_forest"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_question_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Add question image"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/l2e_forest" />

        <ImageButton
            android:id="@+id/btn_remove_question"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_danger"
            android:contentDescription="Remove question"
            android:src="@drawable/ic_delete_small"
            app:tint="@color/white" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_question_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tactile_input_borderless"
        android:gravity="top"
        android:hint="Write your question"
        android:minHeight="72dp"
        android:padding="14dp"
        android:textColor="@color/l2e_ink"
        android:textColorHint="@color/l2e_muted" />

    <ImageView
        android:id="@+id/iv_question_image"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Question image"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <Switch
        android:id="@+id/switch_multiple_answers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Allow multiple correct answers"
        android:textColor="@color/l2e_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ll_choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btn_add_choice"
        style="@style/L2E.Button"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_btn_secondary"
        android:text="Add answer"
        android:textColor="@color/l2e_forest"
        android:textSize="13sp" />
</LinearLayout>
