<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_child_item"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Card Header (Collapsed / Visible State) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_status_dot_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:textColor="@color/l2e_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_child_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/l2e_success"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_expand"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_child_icon_tile"
            android:contentDescription="Manage child device"
            android:padding="10dp"
            android:src="@drawable/ic_more_small"
            app:tint="@color/l2e_forest" />
    </LinearLayout>

    <!-- Expanded Details Container -->
    <LinearLayout
        android:id="@+id/child_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ============================================ -->
        <!-- ZONE 1: TIME BALANCES                        -->
        <!-- ============================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="TIME BALANCES"
            android:textColor="@color/l2e_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 2-Column Sub-Accounts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Daily Free Sub-Account -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_time_free_outer"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_free_inner"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="DAILY FREE"
                        android:textColor="@color/l2e_forest"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_screentime_limit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:contentDescription="Adjust daily free time"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:textColor="@color/l2e_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Resets each day"
                        android:textColor="@color/l2e_muted"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_adjust_daily"
                        style="@style/L2E.Button"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:backgroundTint="@null"
                        android:text="Change"
                        android:textColor="@color/l2e_forest"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Time Bank Sub-Account -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_time_bank_outer"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_bank_inner"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="TIME BANK"
                        android:textColor="@color/l2e_bank_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_earned_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Saved rewards"
                        android:textColor="@color/l2e_bank_muted"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_adjust_bank"
                        style="@style/L2E.Button"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:backgroundTint="@null"
                        android:text="Change"
                        android:textColor="@color/l2e_forest"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Today's Running Balance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="TODAY'S REMAINING TIME"
                    android:textColor="@color/l2e_forest"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/l2e_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_adjust_today"
                style="@style/L2E.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:backgroundTint="@null"
                android:text="Add / Cut"
                android:textColor="@color/l2e_forest"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_resume_timer"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:text="Resume normal timer"
            android:textColor="@color/l2e_forest"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- ============================================ -->
        <!-- ZONE 2: LEARNING & QUIZZES                   -->
        <!-- ============================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="LEARNING &amp; QUIZZES"
            android:textColor="@color/l2e_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Study Energy Gauge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Study Energy"
                android:src="@drawable/ic_child_earn"
                app:tint="@color/l2e_forest" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="DAILY STUDY ENERGY"
                    android:textColor="@color/l2e_forest"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_study_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/l2e_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_study_energy_info"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="About Study Energy"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/l2e_muted" />

            <Button
                android:id="@+id/btn_study_energy"
                style="@style/L2E.Button"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:backgroundTint="@null"
                android:text="Set"
                android:textColor="@color/l2e_forest"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Learning Plan & Quiz Actions (Side by Side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_learning_plan"
                style="@style/L2E.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_child_earn"
                android:drawablePadding="6dp"
                android:text="Learning plan"
                android:textColor="@color/l2e_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_assign_quizzes"
                style="@style/L2E.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_child_earn"
                android:drawablePadding="6dp"
                android:drawableTint="@color/white"
                android:text="Assign quizzes"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================ -->
        <!-- ZONE 3: APP RESTRICTIONS & POLICY            -->
        <!-- ============================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="APP RESTRICTIONS"
            android:textColor="@color/l2e_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enforce time limits"
                    android:textColor="@color/l2e_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_restriction_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/l2e_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_restrictions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Enable time restrictions"
                android:thumbTint="@color/l2e_surface"
                android:trackTint="@color/l2e_forest" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_app_settings"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:backgroundTint="@null"
            android:drawableStart="@android:drawable/ic_menu_manage"
            android:drawablePadding="8dp"
            android:text="Manage apps that use time"
            android:textColor="@color/l2e_forest"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ============================================ -->
        <!-- ZONE 4: DEVICE CONTROLS                      -->
        <!-- ============================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="DEVICE CONTROLS"
            android:textColor="@color/l2e_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_details_lock"
                style="@style/L2E.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_rename"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Rename child device"
                android:padding="11dp"
                android:src="@drawable/ic_edit_small"
                app:tint="@color/l2e_forest" />

            <ImageButton
                android:id="@+id/btn_unpair"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_danger"
                android:contentDescription="Unpair child device"
                android:padding="11dp"
                android:src="@drawable/ic_delete_small"
                app:tint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
