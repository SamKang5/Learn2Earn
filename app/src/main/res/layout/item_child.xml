<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_child_item"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_status_dot_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/l2e_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_child_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/l2e_success"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_expand"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Manage child device"
            android:src="@drawable/ic_more_small"
            app:tint="@color/l2e_forest" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/child_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_details_lock"
                style="@style/L2E.Button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/white" />

            <ImageButton
                android:id="@+id/btn_rename"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Rename child device"
                android:src="@drawable/ic_edit_small"
                app:tint="@color/l2e_forest" />

            <ImageButton
                android:id="@+id/btn_unpair"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_danger"
                android:contentDescription="Unpair child device"
                android:src="@drawable/ic_delete_small"
                app:tint="@color/white" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_resume_timer"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="Resume normal timer"
            android:textColor="@color/l2e_forest"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="TIME CONTROLS"
            android:textColor="@color/l2e_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_time_free_outer"
                android:orientation="vertical"
                android:padding="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_free_inner"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAILY FREE"
                        android:textColor="@color/l2e_forest"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_screentime_limit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:contentDescription="Adjust daily free time"
                        android:focusable="true"
                        android:textColor="@color/l2e_ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Resets each day"
                        android:textColor="@color/l2e_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_adjust_daily"
                        style="@style/L2E.Button"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="Change"
                        android:textColor="@color/l2e_forest"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_time_bank_outer"
                android:orientation="vertical"
                android:padding="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_bank_inner"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME BANK"
                        android:textColor="@color/l2e_bank_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_earned_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Keeps until used"
                        android:textColor="@color/l2e_bank_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_adjust_bank"
                        style="@style/L2E.Button"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="Change"
                        android:textColor="@color/l2e_forest"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Study Energy"
                android:src="@drawable/ic_child_earn"
                app:tint="@color/l2e_forest" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDY ENERGY"
                    android:textColor="@color/l2e_forest"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_study_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/l2e_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_study_energy_info"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="About Study Energy"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/l2e_muted" />

            <Button
                android:id="@+id/btn_study_energy"
                style="@style/L2E.Button"
                android:layout_width="62dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Set"
                android:textColor="@color/l2e_forest"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_learning_plan"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:drawableStart="@drawable/ic_child_earn"
            android:drawablePadding="10dp"
            android:text="Learning plan"
            android:textColor="@color/l2e_forest" />

        <Button
            android:id="@+id/btn_assign_quizzes"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:drawableStart="@drawable/ic_child_earn"
            android:drawablePadding="10dp"
            android:text="Assign quizzes"
            android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S FREE TIME LEFT"
                    android:textColor="@color/l2e_forest"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/l2e_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_adjust_today"
                style="@style/L2E.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Add or remove"
                android:textColor="@color/l2e_forest"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="APP PROTECTION"
            android:textColor="@color/l2e_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_screentime_limit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enforce time limits"
                    android:textColor="@color/l2e_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_restriction_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/l2e_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_restrictions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Enable time restrictions"
                android:thumbTint="@color/l2e_surface"
                android:trackTint="@color/l2e_forest" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_app_settings"
            style="@style/L2E.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary"
            android:drawableStart="@android:drawable/ic_menu_manage"
            android:drawablePadding="10dp"
            android:text="Manage apps that use time"
            android:textColor="@color/l2e_forest" />

    </LinearLayout>
</LinearLayout>
