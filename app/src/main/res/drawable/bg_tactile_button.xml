<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Button shifted down and right, shadow disappears/shrinks -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Minor shadow offset for pressed feedback -->
            <item android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:right="2dp" android:bottom="2dp">
                <shape>
                    <solid android:color="#1A1A1A" />
                    <stroke android:width="3dp" android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default state: Floating button with thick black offset shadow -->
    <item>
        <layer-list>
            <!-- Bold black flat shadow -->
            <item android:left="6dp" android:top="6dp">
                <shape>
                    <solid android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Button face -->
            <item android:right="6dp" android:bottom="6dp">
                <shape>
                    <solid android:color="#212121" />
                    <stroke android:width="3dp" android:color="#000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
