<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:duration="90" android:interpolator="@interpolator/l2e_emphasized">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.98" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.98" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:duration="180" android:interpolator="@interpolator/l2e_emphasized">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
